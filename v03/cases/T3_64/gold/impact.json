  "change": {
    "new_req": "Req. 19",
    "component": "앱",
    "title": "동기화 상태 표시",
    "related_secs": [
      "SI-01"
    ],
    "draft": {
      "설명": "앱은 서버와의 동기화 상태를 화면에 표시하여야 하며, 전송 데이터의 무결성 확인에 실패하면 사용자에게 이를 알려야 한다.",
      "목적": "사용자가 기록이 서버에 제대로 반영되었는지 알 수 있게 하고, 무결성 오류가 생긴 기록을 놓치지 않도록 하기 위함이다.",
      "기준": [
        "동기화가 끝나면 마지막 동기화 시각이 표시됨을 확인함",
        "무결성 확인에 실패한 전송이 있으면 사용자에게 알림이 표시됨을 확인함"
      ],
      "설계": [
        "• 설정 화면에 동기화 상태와 마지막 동기화 시각을 표시하도록 구현한다.",
        "• 동기화 시 전송 데이터의 무결성 검증 결과를 함께 받는다.",
        "• 검증에 실패한 전송이 있으면 상태를 오류로 표시하고 다시 동기화하도록 안내한다."
      ]
    },
    "attr_change": {
      "attr": "remote_update",
      "old": false,
      "new": true,
      "direction": "false->true",
      "rules": [
        "R09",
        "R10"
      ]
    }
  },

    "draft": {
      "설명": "앱은 베개와 매트리스 등 침구 상태에 관한 점검 문항에 응답하도록 하여야 하며, 응답 값이 정해진 선택지와 형식에 맞는지 검증하여야 한다.",
      "목적": "불편한 침구로 인한 수면 방해를 찾아 개선하도록 돕고, 잘못된 응답이 저장되지 않도록 하기 위함이다.",
      "기준": [
        "정해진 선택지 안의 침구 점검 응답이 저장됨을 확인함",
        "선택지에 없거나 형식이 틀린 응답은 저장되지 않음을 확인함"
      ],
      "설계": [
        "• 수면 위생 교육 메뉴에 침구 점검 문항을 추가하도록 구현한다.",
        "• 응답 값은 저장 전에 선택지 목록과 형식을 기준으로 검사한다.",
        "• 점검 결과에 따라 침구 개선 안내를 표시하도록 한다."
      ]
    },

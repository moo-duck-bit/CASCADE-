  "change": {
    "new_req": "Req. 19",
    "component": "앱",
    "title": "동거인 방해 기록",
    "related_secs": [
      "DC-01"
    ],
    "draft": {
      "설명": "사용자는 동거인 때문에 잠을 깬 경우를 기록할 수 있어야 하며, 타인 정보가 담길 수 있는 이 기록은 기기 내부에 암호화된 형태로 저장되어야 한다.",
      "목적": "수면 방해 요인을 파악하여 상담에 활용하고, 사용자와 타인의 정보가 노출되지 않도록 하기 위함이다.",
      "기준": [
        "동거인 방해 기록이 수면일기와 함께 조회됨을 확인함",
        "기기에 저장된 방해 기록이 암호화되어 있어 앱 밖에서 내용을 읽을 수 없음을 확인함"
      ],
      "설계": [
        "• 수면일기 화면에 동거인 방해 여부와 메모를 입력하는 항목을 추가하도록 구현한다.",
        "• 방해 기록은 기기 내부 저장소에 암호화하여 저장한다.",
        "• 방해 기록은 사용자가 공유를 선택한 경우에만 의료진 대시보드에 표시하도록 한다."
      ]
    },
    "attr_change": {
      "attr": "samd",
      "old": true,
      "new": false,
      "direction": "true->false",
      "rules": [
        "R05",
        "R06"
      ]
    }
  },

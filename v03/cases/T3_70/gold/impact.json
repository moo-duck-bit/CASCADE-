  "change": {
    "new_req": "Req. 109",
    "component": "서버",
    "title": "여행 일정 안내",
    "related_secs": [
      "UC-06"
    ],
    "draft": {
      "설명": "서버는 사용자가 등록한 여행 일정에 맞춰 수면 안내를 보낼 수 있어야 하며, 시간대가 바뀌어도 기록의 타임스탬프를 같은 기준 시각으로 저장하여야 한다.",
      "목적": "여행 중 시차로 수면 리듬이 깨지는 것을 줄이고, 시간대 변경으로 기록 순서가 뒤섞이지 않도록 하기 위함이다.",
      "기준": [
        "여행 일정에 맞춰 현지 시각 기준의 수면 안내가 전송됨을 확인함",
        "시간대가 바뀐 뒤 저장된 기록도 같은 기준 시각의 타임스탬프로 저장됨을 확인함"
      ],
      "설계": [
        "• 서버는 사용자가 등록한 여행 일정과 현지 시간대를 저장하도록 구현한다.",
        "• 수면 안내는 현지 시간대로 바꾼 시각에 전송한다.",
        "• 기록의 타임스탬프는 시간대와 관계없이 같은 기준 시각으로 변환하여 저장한다."
      ]
    },
    "attr_change": {
      "attr": "stores_pii",
      "old": false,
      "new": true,
      "direction": "false->true",
      "rules": [
        "R03"
      ]
    }
  },

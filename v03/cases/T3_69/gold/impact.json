  "change": {
    "new_req": "Req. 19",
    "component": "앱",
    "title": "휴일 일정 안내",
    "related_secs": [
      "SI-05"
    ],
    "draft": {
      "설명": "사용자는 휴일 일정을 입력할 수 있어야 하며, 앱은 입력값의 형식과 범위를 검증한 뒤 해당 날짜의 취침·기상 안내를 조정하여야 한다.",
      "목적": "휴일에도 수면 리듬을 유지하도록 돕고, 잘못된 일정이 안내에 반영되지 않도록 하기 위함이다.",
      "기준": [
        "올바른 휴일 일정을 입력하면 해당 날짜의 취침·기상 안내가 조정됨을 확인함",
        "형식이 틀리거나 범위를 벗어난 일정은 저장되지 않음을 확인함"
      ],
      "설계": [
        "• 알림 설정 화면에 휴일 일정 입력 기능을 추가하도록 구현한다.",
        "• 입력된 날짜와 시각은 저장 전에 형식과 허용 범위를 검사한다.",
        "• 저장된 휴일 일정에 맞춰 그날의 취침·기상 안내 시각을 조정하도록 한다."
      ]
    },
    "attr_change": {
      "attr": "remote_update",
      "old": false,
      "new": true,
      "direction": "false->true",
      "rules": [
        "R09",
        "R10"
      ]
    }
  },
